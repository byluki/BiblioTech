# Copiá este archivo como ".env" (en la raíz, junto a docker-compose.yml) o
# agregá estas dos lineas a un .env que ya tengas ahi.
# Sirven SOLO para que docker-compose arme la imagen con tu propio UID/GID
# y evitar problemas de permisos con archivos creados dentro del contenedor.
#
# Para saber tus valores reales, corré en tu WSL:
#   id -u   (UID)
#   id -g   (GID)

UID=1000
GID=1000
