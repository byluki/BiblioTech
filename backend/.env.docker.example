APP_NAME="Biblioteca Barrial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de datos (usa el nombre del servicio de docker-compose, no 127.0.0.1) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=biblioteca_barrial
DB_USERNAME=biblioteca
DB_PASSWORD=secret

# --- Sanctum: dominios de las interfaces que consumen la API por cookie/sesión ---
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=localhost

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- CORS: origen(es) del frontend separados por coma ---
CORS_ALLOWED_ORIGINS=*
