APP_NAME="Biblioteca Barrial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de datos ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biblioteca_barrial
DB_USERNAME=root
DB_PASSWORD=

# --- Alternativa rápida sin instalar MySQL (para probar local) ---
# DB_CONNECTION=sqlite
# (y correr: touch database/database.sqlite)

# --- Sanctum: dominios de las 3 interfaces que consumen la API por cookie/sesión ---
# Si las interfaces usan Bearer token (recomendado, ver AuthController), esto no es
# estrictamente necesario. Dejalo si alguna interfaz usa autenticación por sesión/cookie.
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=localhost

# --- CORS: origen(es) del frontend separados por coma (vacío = cualquiera) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000
