APP_NAME="Biblioteca Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de datos (con Docker, DB_HOST=db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=biblioteca_barrial
DB_USERNAME=biblioteca
DB_PASSWORD=secret

SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=localhost

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Orígenes permitidos para el frontend, separados por coma (* = cualquiera)
CORS_ALLOWED_ORIGINS=*
